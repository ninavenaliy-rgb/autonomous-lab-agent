# ============================================================
# Autonomous Lab Agent — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ── LLM Provider (choose one) ────────────────────────────────
# Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (if using OpenAI)
OPENAI_API_KEY=sk-...

# Model selection
LLM_CLAUDE_MODEL=claude-sonnet-4-6
LLM_CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
LLM_OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1

# ── Vision / OCR ─────────────────────────────────────────────
# OCR backend: "easyocr", "tesseract", or "both"
VISION_OCR_BACKEND=easyocr

# Tesseract executable path (Windows)
VISION_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# DPI scale factor (1.0 = auto-detect)
VISION_DPI_SCALE_FACTOR=1.0

# Confidence threshold for OCR results
VISION_CONFIDENCE_THRESHOLD=0.75

# ── UI Automation ─────────────────────────────────────────────
# Backend: "uia" (recommended) or "win32"
UI_BACKEND=uia

# Delays (milliseconds)
UI_ACTION_DELAY_MS=150
UI_CLICK_DELAY_MS=100
UI_FOCUS_WAIT_MS=500
UI_WAIT_TIMEOUT_SECONDS=30
UI_FIND_ELEMENT_TIMEOUT_SECONDS=15

# ── Recovery ─────────────────────────────────────────────────
RECOVERY_WATCHDOG_INTERVAL_SECONDS=5
RECOVERY_HANG_THRESHOLD_SECONDS=60
RECOVERY_MAX_CRASH_RESTARTS=3
RECOVERY_RESTART_WAIT_SECONDS=8
RECOVERY_MAX_ACTION_RETRIES=5

# ── Report Settings ───────────────────────────────────────────
REPORT_AUTHOR=Autonomous Lab Agent
REPORT_UNIVERSITY=
REPORT_DEPARTMENT=
REPORT_FONT_NAME=Times New Roman
REPORT_FONT_SIZE_BODY=14
REPORT_LINE_SPACING=1.5
REPORT_FIGURE_CAPTION_PREFIX=Рисунок
REPORT_TABLE_CAPTION_PREFIX=Таблица

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Storage paths (relative to project root) ─────────────────
# STORAGE_DB_PATH=storage/agent.db
# STORAGE_CHECKPOINT_DIR=storage/checkpoints
# STORAGE_SCREENSHOT_DIR=logs/screenshots
# STORAGE_REPORT_OUTPUT_DIR=reports
